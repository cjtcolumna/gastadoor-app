{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "GastaDoor Tutor",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git restore --staged *)",
      "Bash(git remote -v)",
      "Bash(flutter pub *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter run *)",
      "Bash(flutter build *)",
      "Bash(flutter doctor *)",
      "Bash(flutter devices *)",
      "Bash(flutter emulators *)",
      "Bash(flutter clean *)",
      "Bash(flutter --version)",
      "Bash(dart format *)",
      "Bash(dart analyze *)",
      "Bash(dart fix *)",
      "Bash(dart test *)",
      "Bash(dart pub *)",
      "Bash(dart run build_runner *)",
      "Bash(dart --version)",
      "Bash(open -a Simulator *)",
      "Bash(xcrun simctl list *)",
      "Bash(pod install *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "mcp__dart__*",
      "WebSearch",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:riverpod.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(brew *)",
      "Bash(supabase *)",
      "Edit(./env.json)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(cat *env.json*)",
      "Bash(cat *.env*)",
      "Read(./env.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  }
}
